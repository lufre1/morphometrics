# ============================================================
# 3D AXON ANALYSIS — MEDIAN MITOCHONDRIAL ELONGATION
# EXPLORATORY AXON-LEVEL ANALYSIS
# ============================================================

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import mannwhitneyu


# ------------------------------------------------------------
# (1) SETTINGS
# ------------------------------------------------------------
file_name = "axon_level_mito_summary_analysis.csv"

value_col = "median_mito_elongation"

group_labels = ["WT", r"$\mathit{Plp}^{-/y}$"]

y_label = "Median mitochondrial elongation (a/c)"
plot_title = "3D median mitochondrial elongation per axon"

y_max = 12
bracket_y = 11.5
bracket_h = 0.15

WT_COLOR = "#1b9e77"
KO_COLOR = "#fc8d62"

table_dir = "table"
plot_dir = "Plots"

os.makedirs(table_dir, exist_ok=True)
os.makedirs(plot_dir, exist_ok=True)


# ------------------------------------------------------------
# (2) LOAD DATA
# ------------------------------------------------------------
df = pd.read_csv(
    file_name,
    sep=None,
    engine="python"
)

df.columns = (
    df.columns
    .astype(str)
    .str.strip()
    .str.replace("\ufeff", "", regex=False)
)

print("\n==================== RAW DATA ====================")
print("\nDetected columns:")
print(df.columns.tolist())
print("\nFirst rows:")
print(df.head())


# ------------------------------------------------------------
# (3) REQUIRED COLUMNS
# ------------------------------------------------------------
required_cols = [
    "mouse_id",
    "genotype",
    "cell_id",
    value_col
]

missing = [c for c in required_cols if c not in df.columns]

if missing:
    raise ValueError(f"Missing columns: {missing}")


# ------------------------------------------------------------
# (4) CLEAN DATA
# ------------------------------------------------------------
df["genotype"] = (
    df["genotype"]
    .astype(str)
    .str.strip()
    .str.lower()
)

df = df[df["genotype"].isin(["wt", "ko"])].copy()

# Numbers exports often convert integer IDs to values such as 39.0.
df["cell_id"] = (
    df["cell_id"]
    .astype(float)
    .astype(int)
    .astype(str)
)

df[value_col] = (
    df[value_col]
    .astype(str)
    .str.replace(",", ".", regex=False)
)

df[value_col] = pd.to_numeric(
    df[value_col],
    errors="coerce"
)

df = df.dropna(
    subset=[
        "genotype",
        "cell_id",
        value_col
    ]
).copy()

print("\n==================== CLEANED DATA ====================")
print("\nRemaining rows:")
print(len(df))

print("\nAxons per genotype:")
print(df.groupby("genotype")["cell_id"].nunique())

print("\nSummary statistics:")
print(df[value_col].describe())


# ------------------------------------------------------------
# (5) EXTRACT AXON-LEVEL VALUES
# ------------------------------------------------------------
# Each row already represents one axon.
#
# Small points in the plot = individual axons
# Large points in the plot = genotype median
# ------------------------------------------------------------
wt_values = (
    df.loc[
        df["genotype"] == "wt",
        value_col
    ]
    .dropna()
    .astype(float)
    .values
)

ko_values = (
    df.loc[
        df["genotype"] == "ko",
        value_col
    ]
    .dropna()
    .astype(float)
    .values
)

print("\n==================== AXON-LEVEL VALUES ====================")
print(f"WT axons: {len(wt_values)}")
print(f"KO axons: {len(ko_values)}")


# ------------------------------------------------------------
# (6) DESCRIPTIVE STATISTICS
# ------------------------------------------------------------
wt_mean = np.mean(wt_values)
wt_sd = np.std(wt_values, ddof=1)
wt_median = np.median(wt_values)

ko_mean = np.mean(ko_values)
ko_sd = np.std(ko_values, ddof=1)
ko_median = np.median(ko_values)

print("\n==================== DESCRIPTIVE STATISTICS ====================")
print(f"WT mean ± SD: {wt_mean:.4f} ± {wt_sd:.4f}")
print(f"WT median: {wt_median:.4f}")

print(f"KO mean ± SD: {ko_mean:.4f} ± {ko_sd:.4f}")
print(f"KO median: {ko_median:.4f}")


# ------------------------------------------------------------
# (7) EXPLORATORY MANN–WHITNEY U TEST
# ------------------------------------------------------------
# This test is exploratory only because only one mouse per genotype exists.
# No genotype-level biological inference is claimed.
# ------------------------------------------------------------
print("\n==================== EXPLORATORY MANN-WHITNEY U TEST ====================")

mw_result = mannwhitneyu(
    wt_values,
    ko_values,
    alternative="two-sided"
)

mw_u = mw_result.statistic
mw_p = mw_result.pvalue

print(f"Exploratory Mann–Whitney U statistic: {mw_u}")
print(f"Exploratory p-value: {mw_p:.6g}")


# ------------------------------------------------------------
# (8) SAVE TABLES
# ------------------------------------------------------------
summary_table = pd.DataFrame({
    "Genotype": ["WT", "KO"],
    "n_axons": [len(wt_values), len(ko_values)],
    "Mean": [wt_mean, ko_mean],
    "SD": [wt_sd, ko_sd],
    "Median": [wt_median, ko_median]
})

statistics_table = pd.DataFrame({
    "Outcome": [value_col],
    "Unit": ["a/c ratio"],
    "Exploratory_Mann_Whitney_U": [mw_u],
    "Exploratory_p_value": [mw_p]
})

summary_table_path = os.path.join(
    table_dir,
    "3d_median_mito_elongation_summary_table.csv"
)

statistics_table_path = os.path.join(
    table_dir,
    "3d_median_mito_elongation_statistics_table.csv"
)

summary_table.to_csv(summary_table_path, index=False)
statistics_table.to_csv(statistics_table_path, index=False)


# ------------------------------------------------------------
# (9) CREATE PLOT
# ------------------------------------------------------------
fig, ax = plt.subplots(figsize=(5.0, 5.6))

data = [wt_values, ko_values]

parts = ax.violinplot(
    data,
    positions=[0, 1],
    showmeans=False,
    showmedians=False,
    showextrema=False,
    widths=0.6,
    bw_method=0.3,
    points=200
)

for i, pc in enumerate(parts["bodies"]):

    color = WT_COLOR if i == 0 else KO_COLOR

    pc.set_facecolor(color)
    pc.set_alpha(0.35)
    pc.set_edgecolor("black")
    pc.set_linewidth(1.0)

box = ax.boxplot(
    data,
    positions=[0, 1],
    widths=0.18,
    patch_artist=True,
    showfliers=False
)

for patch, color in zip(
    box["boxes"],
    [WT_COLOR, KO_COLOR]
):

    patch.set_facecolor(color)
    patch.set_alpha(0.5)
    patch.set_edgecolor("black")
    patch.set_linewidth(1.2)

for median in box["medians"]:
    median.set_color("black")
    median.set_linewidth(1.5)

for whisker in box["whiskers"]:
    whisker.set_linewidth(1.2)

for cap in box["caps"]:
    cap.set_linewidth(1.2)


# ------------------------------------------------------------
# Scatter points
#
# Small points = individual axons
# Large points = genotype median
# ------------------------------------------------------------
print("\n==================== PLOT INFORMATION ====================")

print("Small points = individual axons")
print("Large points = genotype median")

rng = np.random.default_rng(0)

ax.scatter(
    rng.normal(0, 0.08, len(wt_values)),
    wt_values,
    s=35,
    alpha=0.7,
    color=WT_COLOR,
    zorder=3
)

ax.scatter(
    rng.normal(1, 0.08, len(ko_values)),
    ko_values,
    s=35,
    alpha=0.7,
    color=KO_COLOR,
    zorder=3
)

ax.scatter(
    0,
    wt_median,
    s=180,
    color=WT_COLOR,
    edgecolor="white",
    linewidth=1.0,
    zorder=5
)

ax.scatter(
    1,
    ko_median,
    s=180,
    color=KO_COLOR,
    edgecolor="white",
    linewidth=1.0,
    zorder=5
)


# ------------------------------------------------------------
# Add exploratory p-value
# ------------------------------------------------------------
def add_bracket(ax, x1, x2, y, h, text):

    ax.plot(
        [x1, x1, x2, x2],
        [y, y + h, y + h, y],
        lw=1.3,
        color="black"
    )

    ax.text(
        (x1 + x2) / 2,
        y + h + 0.05,
        text,
        ha="center",
        va="bottom",
        fontsize=11
    )


p_text = f"exploratory p = {mw_p:.3f}"

add_bracket(
    ax,
    0,
    1,
    bracket_y,
    bracket_h,
    p_text
)


# ------------------------------------------------------------
# Axis styling
# ------------------------------------------------------------
ax.set_ylabel(y_label)

ax.set_title(
    plot_title,
    pad=20
)

ax.set_xticks([0, 1])

ax.set_xticklabels(group_labels)

ax.set_ylim(0, y_max)

ax.set_yticks(np.arange(0, y_max + 0.001, 2))

ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)

ax.tick_params(
    width=1.2,
    length=5
)

plt.tight_layout()


# ------------------------------------------------------------
# SAVE FIGURE
# ------------------------------------------------------------
pdf_path = os.path.join(
    plot_dir,
    "3d_median_mito_elongation.pdf"
)

plt.savefig(
    pdf_path,
    format="pdf",
    bbox_inches="tight"
)

print("\nPlot saved as:")
print(pdf_path)

plt.show()


# ------------------------------------------------------------
# (10) FINAL REPORT
# ------------------------------------------------------------
print("\n==================== FINAL REPORT ====================")

print("IMPORTANT:")
print("This analysis is exploratory only.")
print("Only one mouse per genotype was available.")
print("Therefore, no genotype-level biological inference is made.")

print(f"\nWT axons: {len(wt_values)}")
print(f"KO axons: {len(ko_values)}")

print(f"\nExploratory Mann–Whitney p-value: {mw_p:.6g}")

print("\nFiles saved:")
print(summary_table_path)
print(statistics_table_path)
print(pdf_path)
